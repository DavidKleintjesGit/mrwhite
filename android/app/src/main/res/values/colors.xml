<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The game's own black. Used for the launch screen and for whatever shows
      behind the system bars, so the app never flashes a colour it does not
      own.
    -->
    <color name="brandInk">#0d0d0d</color>

    <!--
      Het papier van het lichte thema. Dat is waar de app op opent, dus het
      opstartscherm en de achtergrond van het venster staan er ook op: anders
      is het eerste wat je ziet een zwart vlak dat omslaat zodra de pagina
      verft.
    -->
    <color name="brandPaper">#F3F0E8</color>
</resources>
